# The scaffold runs without credentials. Configure real integrations later.
# Server-only values; never add NEXT_PUBLIC_ to credentials.
SERVER_CLOUDBASE_PG_REST_BASE_URL=
SERVER_CLOUDBASE_PG_API_KEY=
SERVER_CODEBUDDY_API_KEY=

# ---------------------------------------------------------------------------
# 自适应测评的 AI 行为（都可选，留空即用默认值）
# ---------------------------------------------------------------------------

# 模型决定"下一题问什么"的频率。实测一次调用需 13～15 秒起步（CLI 子进程固定开销）
# 加上生成，带 JSON 约束的提问约 25～45 秒 —— 每题都调会让整场测评光等待就 3～5 分钟，
# 对 PRD 要求的"3～5 分钟走完闭环"不可接受，所以默认取 checkpoints。
#   checkpoints 每答完 3 题交给模型（它每次仍会完整读一遍全部作答），其余用规则推进（默认）
#   every       从第二题起每题都由模型决定（最个性化，但每题要等 20～45 秒）
#   off         完全不调用模型，纯规则（本地快速回归）
# 注：无论哪种模式，第一题都用规则瞬时返回 —— 那时模型没有任何作答可参考。
SERVER_AI_STEP_MODE=

# 单次模型调用的超时（毫秒），默认 60000。设太小会让调用被截断并静默降级成规则。
SERVER_AI_TIMEOUT_MS=

# 设为 1 时把模型错误的具体信息打进服务端日志。默认关闭：错误文本可能带请求上下文。
# 密钥本身永远不会被记录。
SERVER_AI_DEBUG=

# ---------------------------------------------------------------------------
# 科研问答的 AI 开关（C 模块）
# ---------------------------------------------------------------------------

# 问答链路的模型调用开关。**这是一个"关得掉"的开关，不是优化项**：
# AI 走个人 CodeBuddy 额度，而问答接口挂在公开可访问的站点上，
# 演示前或额度紧张时需要能不改代码就立刻停掉模型调用。
#   off 完全不调模型，全部走规则回答（页面照常工作，只是不再出现"模型生成"角标）
# 留空 = on：配了密钥就用模型；没配密钥或调用失败都自动回落规则。
#
# 另：无论开关如何，**证据不足的提问根本不会调用模型**（规则引擎先跑一遍选证据），
# 所以「问人品」「让编论文」「问名额」这类问句不花钱。
SERVER_AI_QA_MODE=
