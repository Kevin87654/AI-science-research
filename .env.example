# 环境变量模板。真实值只放 .env.local 或部署平台，**绝不入库**。
# 服务端专用；不要给凭据加 NEXT_PUBLIC_ 前缀。
SERVER_CLOUDBASE_PG_REST_BASE_URL=
SERVER_CLOUDBASE_PG_API_KEY=

# ---------------------------------------------------------------------------
# AI 直连（DeepSeek / OpenAI 兼容接口）
# ---------------------------------------------------------------------------

# 服务端专用密钥。绝不进浏览器、日志或错误信息。
SERVER_AI_API_KEY=

# OpenAI 兼容根地址。留空默认 https://api.deepseek.com
SERVER_AI_BASE_URL=

# 模型名。留空默认 deepseek-flash（快、便宜，适合提醒/汇总）；
# 需要更强生成时可改成 deepseek-v4-pro。
SERVER_AI_MODEL=

# ---------------------------------------------------------------------------
# 自适应测评的 AI 行为（都可选，留空即用默认值）
# ---------------------------------------------------------------------------

# 模型决定"下一题问什么"的频率。直连 API 单次通常 1～5 秒，但"每题都调模型"
# 仍会拉长测评节奏，所以默认取 checkpoints。
#   checkpoints 每答完 3 题交给模型（它每次仍会完整读一遍全部作答），其余用规则推进（默认）
#   every       从第二题起每题都由模型决定（最个性化）
#   off         完全不调用模型，纯规则（本地快速回归）
# 注：无论哪种模式，第一题都用规则瞬时返回 —— 那时模型没有任何作答可参考。
SERVER_AI_STEP_MODE=

# 单次模型调用的超时（毫秒），默认 60000。设太小会让调用被截断并静默降级成规则。
#
# 科研问答链路另有一个 120 秒的下限（见 src/server/ai/qa-answerer.ts）：
# 问答提示词要带完整证据块，模型需要读完再组织答案。这里调得比 120000 大就听你的，
# 调得更小则不采纳 —— 短了必然降级。
SERVER_AI_TIMEOUT_MS=

# 设为 1 时把模型错误的具体信息打进服务端日志。默认关闭：错误文本可能带请求上下文。
# 密钥本身永远不会被记录。
SERVER_AI_DEBUG=

# ---------------------------------------------------------------------------
# 科研问答的 AI 开关（C 模块）
# ---------------------------------------------------------------------------

# 问答链路的模型调用开关。**这是一个"关得掉"的开关，不是优化项**：
# 问答接口挂在公开可访问的站点上，演示前或额度紧张时需要能不改代码就立刻停掉模型调用。
#   off 完全不调模型，全部走规则回答（页面照常工作，只是不再出现"模型生成"角标）
# 留空 = on：配了密钥就用模型；没配密钥或调用失败都自动回落规则。
#
# 另：无论开关如何，**证据不足的提问根本不会调用模型**（规则引擎先跑一遍选证据），
# 所以「问人品」「让编论文」「问名额」这类问句不花钱。
SERVER_AI_QA_MODE=
