# ---------- 依赖 ----------
node_modules/
.pnpm-store/
output/playwright/
.playwright-cli/
.pnp
.pnp.js

# ---------- Next.js 产物 ----------
.next/
out/
build/
dist/

# ---------- 环境变量（密钥绝不入库）----------
.env
.env.local
.env*.local
# 本地凭据的通用兜底：*.local.txt / config.local.* 一律不入库
*.local.txt
config.local.*
!*.local.example.txt

# ---------- Vercel ----------
.vercel

# ---------- TypeScript ----------
*.tsbuildinfo
next-env.d.ts

# ---------- 日志 ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---------- 编辑器 / 系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---------- 本地归档（不入库）----------
